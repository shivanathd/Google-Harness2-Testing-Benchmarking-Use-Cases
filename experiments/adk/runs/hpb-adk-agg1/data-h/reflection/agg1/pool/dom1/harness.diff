-        sys.exit(f"UNPARSEABLE TIMESTAMP: {s!r}")
-    if d.tzinfo is None:
-        sys.exit(f"TIMESTAMP WITHOUT OFFSET: {s!r}")
-    return d.astimezone(timezone.utc)
