-    out = None
-    if "--out" in a:
-        i = a.index("--out")
-        out = a[i + 1]
-        del a[i:i + 2]
-    ch_p, cb_p, cu_p, fx_p, ym = a[:5]
-    year, month = map(int, ym.split("-"))
-    fx = {r["currency"].strip().upper(): Decimal(r["usd_per_unit"]) for r in load(fx_p)}
-    test = {r["customer_id"].strip(): r["is_test"].strip().lower() == "true" for r in load(cu_p)}
-    charges = {}
